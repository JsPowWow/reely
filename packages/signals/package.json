{
  "name": "@reely/signals",
  "version": "0.1.2",
  "description": "Signals, computed values and effects: a push-pull graph with owners that release what a piece of work subscribed. No DOM.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JsPowWow/reely.git"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node ../../scripts/license.mjs"
  },
  "nx": {
    "tags": [
      "scope:shared"
    ],
    "projectType": "library",
    "sourceRoot": "packages/signals/src",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vite build",
          "cwd": "packages/signals"
        },
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "consumer": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node ../../scripts/consumer-check.mjs",
          "cwd": "packages/signals"
        },
        "dependsOn": [
          "build",
          "^build"
        ]
      }
    }
  },
  "devDependencies": {
    "@reely/utils": "*"
  },
  "dependencies": {
    "@reely/basics": "^0.1.0"
  }
}
