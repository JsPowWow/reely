{
  "name": "@reely/strings",
  "version": "0.0.10",
  "description": "Capitalize words and make URL slugs, in any script.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JsPowWow/reely.git"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@reely/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node ../../scripts/license.mjs"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@reely/basics": "^0.1.0"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  },
  "nx": {
    "tags": [
      "scope:strings"
    ],
    "targets": {
      "consumer": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node ../../scripts/consumer-check.mjs",
          "cwd": "packages/strings"
        },
        "dependsOn": [
          "build",
          "^build"
        ]
      }
    }
  }
}
